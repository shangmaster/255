{
  "manifest_version": 3,
  "name": "学习通拍照签到（本地图片）",
  "version": "1.0.0",
  "description": "只做一件事：把本地图片提交为学习通拍照签到 —— 自动识别签到编号、上传图片、提交。",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "activeTab", "scripting", "cookies"],
  "host_permissions": [
    "*://*.chaoxing.com/*",
    "*://*.chaoxing.com.cn/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.chaoxing.com/*", "*://*.chaoxing.com.cn/*"],
      "js": ["src/lib.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "学习通拍照签到",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
